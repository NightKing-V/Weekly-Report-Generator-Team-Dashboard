<mxfile host="65bd71144e">
    <diagram id="mongodb-simplified-er" name="MongoDB Database Schema">
        <mxGraphModel dx="1123" dy="880" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1340" pageHeight="640" background="#ffffff" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>

                <!-- Title Banner (White Background) -->
                <mxCell id="title" value="MongoDB Database Schema — Core Collections &amp; Relationships" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#cbd5e1;strokeWidth=1.5;fillColor=#ffffff;align=center;verticalAlign=middle;fontSize=15;fontStyle=1;fontColor=#0f172a;shadow=0;" parent="1" vertex="1">
                    <mxGeometry x="80" y="30" width="1180" height="42" as="geometry"/>
                </mxCell>

                <!-- ========================================== -->
                <!-- COLLECTION 1: users (White Background)     -->
                <!-- ========================================== -->
                <mxCell id="users_coll" value="users" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=34;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;whiteSpace=wrap;html=1;fillColor=#ffffff;swimlaneFillColor=#ffffff;fontColor=#1e40af;strokeColor=#cbd5e1;strokeWidth=1.5;fontSize=13;rounded=1;shadow=0;" parent="1" vertex="1">
                    <mxGeometry x="280" y="100" width="280" height="190" as="geometry"/>
                </mxCell>
                <mxCell id="users_fields" value="id: string [PK]&#xa;name: string&#xa;email: string&#xa;role: &#39;team_member&#39; | &#39;manager&#39; | &#39;admin&#39;&#xa;title: string&#xa;department: string" style="text;strokeColor=none;fillColor=#ffffff;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=10;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=11;fontColor=#334155;fontFamily=monospace;lineHeight=1.5;" parent="users_coll" vertex="1">
                    <mxGeometry y="34" width="280" height="156" as="geometry"/>
                </mxCell>

                <!-- ========================================== -->
                <!-- COLLECTION 2: projects (White Background)  -->
                <!-- ========================================== -->
                <mxCell id="projects_coll" value="projects" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=34;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;whiteSpace=wrap;html=1;fillColor=#ffffff;swimlaneFillColor=#ffffff;fontColor=#0f766e;strokeColor=#cbd5e1;strokeWidth=1.5;fontSize=13;rounded=1;shadow=0;" parent="1" vertex="1">
                    <mxGeometry x="280" y="380" width="280" height="190" as="geometry"/>
                </mxCell>
                <mxCell id="projects_fields" value="id: string [PK]&#xa;name: string&#xa;code: string (e.g. &#39;CLT-A&#39;)&#xa;status: &#39;Active&#39; | &#39;On Hold&#39; | &#39;Completed&#39;&#xa;assignedMemberIds: Array&lt;string&gt; [FK]" style="text;strokeColor=none;fillColor=#ffffff;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=10;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=11;fontColor=#334155;fontFamily=monospace;lineHeight=1.5;" parent="projects_coll" vertex="1">
                    <mxGeometry y="34" width="280" height="156" as="geometry"/>
                </mxCell>

                <!-- ========================================== -->
                <!-- COLLECTION 3: reports (White Background)   -->
                <!-- ========================================== -->
                <mxCell id="reports_coll" value="reports" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=34;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;whiteSpace=wrap;html=1;fillColor=#ffffff;swimlaneFillColor=#ffffff;fontColor=#4338ca;strokeColor=#cbd5e1;strokeWidth=1.5;fontSize=13;rounded=1;shadow=0;" parent="1" vertex="1">
                    <mxGeometry x="700" y="100" width="340" height="230" as="geometry"/>
                </mxCell>
                <mxCell id="reports_fields" value="id: string [PK]&#xa;userId: string [FK -&gt; users.id]&#xa;projectId: string [FK -&gt; projects.id]&#xa;weekLabel: string&#xa;status: &#39;Draft&#39; | &#39;Submitted&#39; | &#39;Approved&#39;&#xa;tasksCompleted: Array&lt;Task&gt; [Embedded]&#xa;blockers: Array&lt;Blocker&gt; [Embedded]&#xa;hoursWorked: Object [Embedded]" style="text;strokeColor=none;fillColor=#ffffff;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=10;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=11;fontColor=#334155;fontFamily=monospace;lineHeight=1.5;" parent="reports_coll" vertex="1">
                    <mxGeometry y="34" width="340" height="196" as="geometry"/>
                </mxCell>

                <!-- ========================================== -->
                <!-- COLLECTION 4: activities (White Background)-->
                <!-- ========================================== -->
                <mxCell id="activities_coll" value="activities" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=34;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;whiteSpace=wrap;html=1;fillColor=#ffffff;swimlaneFillColor=#ffffff;fontColor=#b45309;strokeColor=#cbd5e1;strokeWidth=1.5;fontSize=13;rounded=1;shadow=0;" parent="1" vertex="1">
                    <mxGeometry x="750" y="410" width="280" height="190" as="geometry"/>
                </mxCell>
                <mxCell id="activities_fields" value="id: string [PK]&#xa;reportId: string [FK -&gt; reports.id]&#xa;type: &#39;submitted&#39; | &#39;approved&#39; | ...&#xa;actorName: string&#xa;timestamp: string (ISO 8601)" style="text;strokeColor=none;fillColor=#ffffff;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=10;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=11;fontColor=#334155;fontFamily=monospace;lineHeight=1.5;" parent="activities_coll" vertex="1">
                    <mxGeometry y="34" width="280" height="156" as="geometry"/>
                </mxCell>

                <!-- ========================================== -->
                <!-- RELATIONSHIPS & REFERENCES                 -->
                <!-- ========================================== -->

                <!-- 1. users -> reports (1:N) -->
                <mxCell id="rel_users_reports" value="1 : N  (userId)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.4;entryDx=0;entryDy=0;exitX=1;exitY=0.4;exitDx=0;exitDy=0;strokeColor=#3b82f6;strokeWidth=2;fontSize=11;fontColor=#1d4ed8;fontStyle=1;labelBackgroundColor=#ffffff;labelBorderColor=#cbd5e1;" parent="1" source="users_coll" target="reports_coll" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>

                <!-- 2. projects -> reports (1:N) -->
                <mxCell id="rel_projects_reports" value="1 : N  (projectId)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.8;entryDx=0;entryDy=0;exitX=1;exitY=0.4;exitDx=0;exitDy=0;strokeColor=#0d9488;strokeWidth=2;fontSize=11;fontColor=#0f766e;fontStyle=1;labelBackgroundColor=#ffffff;labelBorderColor=#cbd5e1;" parent="1" source="projects_coll" target="reports_coll" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>

                <!-- 3. users <-> projects (N:M Assignment) -->
                <mxCell id="rel_users_projects" value="N : M (assignedMemberIds)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;strokeColor=#64748b;strokeWidth=2;fontSize=11;fontColor=#475569;fontStyle=2;dashed=1;labelBackgroundColor=#ffffff;labelBorderColor=#cbd5e1;" parent="1" source="users_coll" target="projects_coll" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>

                <!-- 4. reports -> activities (1:N) -->
                <mxCell id="rel_reports_activities" value="1 : N  (reportId)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;strokeColor=#d97706;strokeWidth=2;fontSize=11;fontColor=#b45309;fontStyle=1;labelBackgroundColor=#ffffff;labelBorderColor=#cbd5e1;" parent="1" source="reports_coll" target="activities_coll" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
