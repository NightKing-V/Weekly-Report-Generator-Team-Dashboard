                <mxCell id="title" value="Weekly Report Generator &amp;amp; Team Dashboard — Backend Structure Diagram&#xa;FastAPI • Domain Services • Pydantic v2 Models • Motor Repositories &amp;amp; MongoDB" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#cbd5e1;strokeWidth=1.5;fillColor=#ffffff;align=center;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#0f172a;shadow=0;" parent="1" vertex="1">
