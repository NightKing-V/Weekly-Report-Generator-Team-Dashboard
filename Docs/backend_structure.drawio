                <mxCell id="route_user" value="&lt;b style=&quot;font-size: 13px; color: #7c3aed;&quot;&gt;user_routes.py (/api/users)&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 11px; color: #64748b;&quot;&gt;FastAPI APIRouter • Auth &amp;amp; User Administration&lt;/span&gt;&lt;br/&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 11px; color: #334155; line-height: 1.4;&quot;&gt;• &lt;b&gt;POST /login&lt;/b&gt;: Verify credentials &amp;amp; issue JWT token&lt;br/&gt;• &lt;b&gt;GET /me&lt;/b&gt;: Fetch authenticated session profile&lt;br/&gt;• &lt;b&gt;GET /&lt;/b&gt;: List team contributors &amp;amp; user directory&lt;br/&gt;• &lt;b&gt;PUT /{user_id}/role&lt;/b&gt;: Update RBAC role [Admin Guard]&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8b5cf6;strokeWidth=1.8;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;shadow=0;" parent="1" vertex="1">
                    <mxGeometry x="60" y="116" width="380" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="route_report" value="&lt;b style=&quot;font-size: 13px; color: rgb(29, 78, 216);&quot;&gt;report_routes.py (/api/reports)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 11px; color: rgb(100, 116, 139);&quot;&gt;FastAPI APIRouter • Lifecycle, Reviews &amp;amp; Aggregates&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size: 11px; color: rgb(51, 65, 85); line-height: 1.4;&quot;&gt;• &lt;b&gt;POST /&lt;/b&gt;: Save draft or upsert weekly report&lt;br&gt;• &lt;b&gt;POST /{id}/submit&lt;/b&gt;: Lock report &amp;amp; queue for review&lt;br&gt;• &lt;b&gt;POST /{id}/review&lt;/b&gt;: Approve / Request changes [Manager]&lt;br&gt;• &lt;b&gt;GET /metrics&lt;/b&gt;: Submission compliance &amp;amp; team KPIs&lt;br&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3b82f6;strokeWidth=1.8;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;shadow=0;" parent="1" vertex="1">
                    <mxGeometry x="470" y="116" width="460" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="route_chat" value="&lt;b style=&quot;font-size: 13px; color: #b45309;&quot;&gt;chat_routes.py (/api/chat, /activities)&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 11px; color: #64748b;&quot;&gt;FastAPI APIRouter • AI Q&amp;amp;A Assistant &amp;amp; Audit Stream&lt;/span&gt;&lt;br/&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 11px; color: #334155; line-height: 1.4;&quot;&gt;• &lt;b&gt;POST /chat/ask&lt;/b&gt;: Natural language Q&amp;amp;A via LangGraph&lt;br/&gt;• &lt;b&gt;GET /activities&lt;/b&gt;: Real-time audit activity feed&lt;br/&gt;• &lt;b&gt;X-Thread-ID&lt;/b&gt;: Ephemeral session thread header&lt;br/&gt;• Strict request schema enforcement via Pydantic v2&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#f59e0b;strokeWidth=1.8;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;shadow=0;" parent="1" vertex="1">
                    <mxGeometry x="960" y="116" width="400" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="service_user" value="&lt;b style=&quot;font-size: 13px; color: #7c3aed;&quot;&gt;Auth &amp;amp; Security Service (app/middleware/auth.py)&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 11px; color: #64748b;&quot;&gt;JWT Token Lifecycle &amp;amp; RBAC Dependency Guards&lt;/span&gt;&lt;br/&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 11px; color: #334155; line-height: 1.4;&quot;&gt;• &lt;b&gt;create_access_token()&lt;/b&gt;: Signs JWT with role &amp;amp; user claims&lt;br/&gt;• &lt;b&gt;verify_password()&lt;/b&gt;: Bcrypt password hash verification&lt;br/&gt;• &lt;b&gt;require_authenticated()&lt;/b&gt;: Decodes Bearer token guard&lt;br/&gt;• &lt;b&gt;require_manager_or_admin()&lt;/b&gt;: Lead authority check&lt;br/&gt;• &lt;b&gt;require_admin()&lt;/b&gt;: Administrator privilege check&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8b5cf6;strokeWidth=1.8;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;shadow=0;" parent="1" vertex="1">
                    <mxGeometry x="60" y="270" width="380" height="145" as="geometry"/>
                </mxCell>
                <mxCell id="service_report" value="&lt;b style=&quot;font-size: 13px; color: #1d4ed8;&quot;&gt;ReportService (app/services/reports/report_service.py)&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 11px; color: #64748b;&quot;&gt;Domain Business Logic, State Machine &amp;amp; KPI Engine&lt;/span&gt;&lt;br/&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 11px; color: #334155; line-height: 1.4;&quot;&gt;• &lt;b&gt;save_draft()&lt;/b&gt;: Idempotent auto-saving without field locks&lt;br/&gt;• &lt;b&gt;submit_report()&lt;/b&gt;: &#39;Submitted&#39; status + immutable version snapshot&lt;br/&gt;• &lt;b&gt;review_report()&lt;/b&gt;: &#39;Approved&#39; / &#39;Needs Correction&#39; state transition&lt;br/&gt;• &lt;b&gt;calculate_metrics()&lt;/b&gt;: Compliance rate % &amp;amp; open blocker counts&lt;br/&gt;• &lt;b&gt;log_activity_event()&lt;/b&gt;: Triggers event logging on state changes&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3b82f6;strokeWidth=1.8;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;shadow=0;" parent="1" vertex="1">
                    <mxGeometry x="470" y="270" width="460" height="145" as="geometry"/>
                </mxCell>
                <mxCell id="service_chat" value="&lt;b style=&quot;font-size: 13px; color: #b45309;&quot;&gt;ChatService &amp;amp; Agent Engine (app/services/chat/)&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 11px; color: #64748b;&quot;&gt;LangGraph StateGraph &amp;amp; Lightweight RAG Engine&lt;/span&gt;&lt;br/&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 11px; color: #334155; line-height: 1.4;&quot;&gt;• &lt;b&gt;ChatService&lt;/b&gt;: Coordinates REST requests with LangGraph&lt;br/&gt;• &lt;b&gt;graph.py&lt;/b&gt;: Multi-turn graph with in-memory MemorySaver&lt;br/&gt;• &lt;b&gt;qna_node (rag.py)&lt;/b&gt;: Direct async MongoDB team context retrieval&lt;br/&gt;• &lt;b&gt;summarize_node&lt;/b&gt;: 5-turn periodic dialogue compression&lt;br/&gt;• &lt;b&gt;Session Privacy&lt;/b&gt;: Zero chat records persisted to database&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#f59e0b;strokeWidth=1.8;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;shadow=0;" parent="1" vertex="1">
                    <mxGeometry x="960" y="270" width="400" height="145" as="geometry"/>
                </mxCell>
                <mxCell id="models_user" value="&lt;b style=&quot;font-size: 13px; color: #7c3aed;&quot;&gt;User Schemas (app/models/users.py)&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 11px; color: #64748b;&quot;&gt;Pydantic v2 Models &amp;amp; Roles&lt;/span&gt;&lt;br/&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 11px; color: #334155; font-family: monospace; line-height: 1.45;&quot;&gt;• &lt;b&gt;UserModel&lt;/b&gt;: id, name, email, role, title, dept&lt;br/&gt;• &lt;b&gt;UserInDB&lt;/b&gt;: UserModel + hashedPassword&lt;br/&gt;• &lt;b&gt;UserCreate / Register&lt;/b&gt;: validation contracts&lt;br/&gt;• &lt;b&gt;LoginRequest&lt;/b&gt;: email, password, optional role&lt;br/&gt;• &lt;b&gt;AuthResponse&lt;/b&gt;: access_token, token_type, user&lt;br/&gt;• &lt;b&gt;UserRole&lt;/b&gt;: &#39;team_member&#39; | &#39;manager&#39; | &#39;admin&#39;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8b5cf6;strokeWidth=1.8;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;shadow=0;" parent="1" vertex="1">
                    <mxGeometry x="60" y="450" width="380" height="155" as="geometry"/>
                </mxCell>
                <mxCell id="models_report" value="&lt;b style=&quot;font-size: 13px; color: #1d4ed8;&quot;&gt;Report Schemas (app/models/reports.py)&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 11px; color: #64748b;&quot;&gt;Pydantic v2 Entities &amp;amp; Embedded Contracts&lt;/span&gt;&lt;br/&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 11px; color: #334155; font-family: monospace; line-height: 1.45;&quot;&gt;• &lt;b&gt;WeeklyReportModel&lt;/b&gt;: tasks, blockers, versions, reviewHistory&lt;br/&gt;• &lt;b&gt;CompletedTaskModel&lt;/b&gt;: taskName, priority, planned/spentHours&lt;br/&gt;• &lt;b&gt;BlockerModel&lt;/b&gt;: description, isKeyIssue, impact&lt;br/&gt;• &lt;b&gt;ReportVersionModel&lt;/b&gt;: versionNumber, submittedAt, snapshot&lt;br/&gt;• &lt;b&gt;DashboardMetricsModel&lt;/b&gt;: complianceRate, approved, pending&lt;br/&gt;• &lt;b&gt;ProjectModel&lt;/b&gt;: id, name, code, status, assignedMemberIds[]&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3b82f6;strokeWidth=1.8;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;shadow=0;" parent="1" vertex="1">
                    <mxGeometry x="470" y="450" width="460" height="155" as="geometry"/>
                </mxCell>
                <mxCell id="models_chat" value="&lt;b style=&quot;font-size: 13px; color: #b45309;&quot;&gt;Chat &amp;amp; Feed Schemas (app/models/chats.py)&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 11px; color: #64748b;&quot;&gt;Assistant Contracts &amp;amp; Activity Events&lt;/span&gt;&lt;br/&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 11px; color: #334155; font-family: monospace; line-height: 1.45;&quot;&gt;• &lt;b&gt;ChatQueryRequest&lt;/b&gt;: message, weekLabel, threadId&lt;br/&gt;• &lt;b&gt;ChatQueryResponse&lt;/b&gt;: reply, sourcesCount, threadId, summary&lt;br/&gt;• &lt;b&gt;ActivityFeedModel&lt;/b&gt;: id, type, actorName, actorRole, message&lt;br/&gt;• &lt;b&gt;ActivityType&lt;/b&gt;: &#39;submitted&#39; | &#39;approved&#39; | &#39;correction_req&#39;&lt;br/&gt;• &lt;b&gt;ChatMessageModel&lt;/b&gt;: sender (&#39;user&#39;|&#39;assistant&#39;), text&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#f59e0b;strokeWidth=1.8;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;shadow=0;" parent="1" vertex="1">
                    <mxGeometry x="960" y="450" width="400" height="155" as="geometry"/>
                </mxCell>
                <mxCell id="repo_user" value="&lt;b style=&quot;font-size: 13px; color: #7c3aed;&quot;&gt;user_repository.py ➔ MongoDB &#39;users&#39;&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 11px; color: #64748b;&quot;&gt;Motor Async Driver • User Collections&lt;/span&gt;&lt;br/&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 11px; color: #334155; line-height: 1.4;&quot;&gt;• &lt;b&gt;get_user_by_email()&lt;/b&gt;: Lookup user &amp;amp; credentials&lt;br/&gt;• &lt;b&gt;get_user_by_id()&lt;/b&gt;: Retrieve single user profile&lt;br/&gt;• &lt;b&gt;get_all_users()&lt;/b&gt;: List all active team members&lt;br/&gt;• &lt;b&gt;update_user_role()&lt;/b&gt;: Persist modified RBAC role&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8b5cf6;strokeWidth=1.8;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;shadow=0;" parent="1" vertex="1">
                    <mxGeometry x="60" y="640" width="380" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="repo_report" value="&lt;b style=&quot;font-size: 13px; color: #1d4ed8;&quot;&gt;report_repository.py ➔ MongoDB &#39;weekly_reports&#39;, &#39;projects&#39;&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 11px; color: #64748b;&quot;&gt;Motor Dynamic Aggregations, Pagination &amp;amp; Version Snapshots&lt;/span&gt;&lt;br/&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 11px; color: #334155; line-height: 1.4;&quot;&gt;• &lt;b&gt;get_reports_by_week()&lt;/b&gt;: Filtered queries, status checks &amp;amp; pagination&lt;br/&gt;• &lt;b&gt;save_or_update_report()&lt;/b&gt;: Atomic draft saving &amp;amp; report updates&lt;br/&gt;• &lt;b&gt;append_version_snapshot()&lt;/b&gt;: Immutable version archiving&lt;br/&gt;• &lt;b&gt;get_all_projects()&lt;/b&gt;: Retrieve project assignments &amp;amp; codes&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3b82f6;strokeWidth=1.8;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;shadow=0;" parent="1" vertex="1">
                    <mxGeometry x="470" y="640" width="460" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="repo_chat" value="&lt;b style=&quot;font-size: 13px; color: #b45309;&quot;&gt;chat_repository.py &amp;amp; Groq Cloud Provider&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 11px; color: #64748b;&quot;&gt;MongoDB &#39;activities&#39; Collection &amp;amp; ChatGroq Cloud LLM&lt;/span&gt;&lt;br/&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 11px; color: #334155; line-height: 1.4;&quot;&gt;• &lt;b&gt;log_activity_event()&lt;/b&gt;: Persists event to &#39;activities&#39; collection&lt;br/&gt;• &lt;b&gt;get_recent_activities()&lt;/b&gt;: High-speed audit stream queries&lt;br/&gt;• &lt;b&gt;LLMFactory / ChatGroq&lt;/b&gt;: Low-latency inference on Groq LPUs&lt;br/&gt;• QnA Model: &lt;i&gt;qwen-2.5-32b&lt;/i&gt; / Summarizer Model: &lt;i&gt;Tier 1&lt;/i&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#f59e0b;strokeWidth=1.8;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;shadow=0;" parent="1" vertex="1">
