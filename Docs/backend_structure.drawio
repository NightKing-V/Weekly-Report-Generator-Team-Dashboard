                <mxCell id="footer_highlights" value="&lt;b style=&quot;color: #0f172a;&quot;&gt;Backend Architectural Principles:&lt;/b&gt;&amp;nbsp;&amp;nbsp;Strict 3-Tier Layer Separation (Route ➔ Service ➔ Repository)&amp;nbsp;&amp;nbsp;•&amp;nbsp;&amp;nbsp;Pydantic v2 Schema Contracts&amp;nbsp;&amp;nbsp;•&amp;nbsp;&amp;nbsp;Pure Async ASGI Event Loop (Motor Client)&amp;nbsp;&amp;nbsp;•&amp;nbsp;&amp;nbsp;Zero DB Chat Storage" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#cbd5e1;strokeWidth=1.2;fillColor=#ffffff;align=center;verticalAlign=middle;fontSize=11;fontColor=#334155;shadow=0;" parent="1" vertex="1">
