# Production Backend Environment Template (Mongo Atlas & Host Deployment)

# Server & Port Configuration
PORT=8000
BACKEND_PORT=8000
HOST=0.0.0.0
ENVIRONMENT=production

# CORS Configuration
# Comma-separated list of allowed frontend production origins
CORS_ORIGINS=https://your-production-frontend-domain.com

# MongoDB Atlas Production Connection
DATABASE_NAME=team_dashboard
MONGO_URL=mongodb+srv://<db_username>:<db_password>@mycluster.3ju2ywg.mongodb.net/team_dashboard?retryWrites=true&w=majority&appName=MyCluster
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@mycluster.3ju2ywg.mongodb.net/team_dashboard?retryWrites=true&w=majority&appName=MyCluster

# JWT Authentication
JWT_SECRET_KEY=generate_a_secure_random_64_character_secret_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Groq LLM Configuration for LangGraph & LangChain Lightweight RAG
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_MODEL_SMALL=qwen/qwen3.8-27b
GROQ_MODEL_LARGE=qwen/qwen3.8-27b

